{
  // TypeScript settings for the Node-side files: vite.config.ts and the cross-browser tests
  // (playwright.config.ts, e2e/ — their page.evaluate callbacks run in the browser, hence "DOM").
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["vite.config.ts", "playwright.config.ts", "e2e"]
}
